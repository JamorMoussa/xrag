API_NAME="xrag"
API_VERSION="v0.1"
API_PREFIX_PATH ="/api/v1"

#---- Services:

STORAGE_BASE_URL="/api/v1/s"

#---- S3:
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin123
S3_REGION=us-east-1
S3_BUCKET=xrag
S3_SIGNATURE_VERSION="s3v4"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10

LITE_PARSER_BASE_URL=http://liteparse:5707

# ---- Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ingestion-queue

# ---- Ollama:
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M
EMBEDDING_BASE_URL=http://ollama:11434

# ---- ChatModel:
CHAT_MODEL_PROVIDER=ollama
CHAT_MODEL_NAME=qwen3:8b
CHAT_MODEL_BASE_URL=http://ollama:11434/v1
CHAT_MODEL_API_KEY=None

# ---- VecDB
VECDB_PROVIDER=qdrant
VECDB_BASE_URL=http://qdrant:6333
VECDB_COLLECTION=xrag
